package GitHub::Actions::AWS::IAM::Permissions;

use strict;
use warnings;

use Role::Tiny;

use CLI::Simple::Constants qw(:booleans);
use CLI::Simple::Utils qw(slurp slurp_json to_snake_case toPascalCase choose);
use Data::Dumper;
use English qw(-no_match_vars);
use List::Util qw(any uniq);
use File::ShareDir qw(dist_dir);
use JSON;
use YAML::Tiny qw(LoadFile Dump);

use Readonly;
Readonly::Scalar our $POLICY_VERSION => '2012-10-17';

caller or exit __PACKAGE__->example();

########################################################################
sub cmd_create_permissions_policy {
########################################################################
  my ($self) = @_;

  my ($permissions) = $self->get_args;

  die "ERROR: usage: assemble-permissions permissions.json|yml\n"
    if !$permissions;

  my $config = eval {
    return slurp_json($permissions)
      if $permissions =~ /[.]json$/xsm;

    return LoadFile($permissions)
      if $permissions =~ /[.]ya?ml$/xsm;

    die "permissions file must be .yaml|.yml|.json\n";
  };

  die "ERROR: could not load permissions from $permissions\n$EVAL_ERROR"
    if !$config || $EVAL_ERROR;

  die "ERROR: invalid format for $permissions, 'capabilities' and 'vars' are required keys\n"
    if !defined $config->{capabilities} || !defined $config->{vars};

  my $fragments = $self->_get_fragments;
  my @statements;

  my %required;

  foreach my $c ( @{ $config->{capabilities} } ) {
    ( my $name = $c ) =~ s/_/-/xsmg;  # normalize to the filename form

    my $statements = $fragments->{$name}
      or die "ERROR: no such permission policy ($c)\n";

    push @statements, @{$statements};  # ALL statements, not [0]

    my $text = encode_json($statements);
    while ( $text =~ /[@]([^@]+)[@]/xsmg ) { $required{$1} = 1; }
  }

  my %have_vars;

  foreach my $k ( keys %{ $config->{vars} } ) {
    my $v = $k;
    $v =~ s/[-]/_/xsmg;
    $have_vars{$v} = $config->{vars}{$k};
  }

  my @missing;

  foreach my $r ( keys %required ) {
    next if any { $_ eq $r } keys %have_vars;
    push @missing, $r;
  }

  die sprintf "ERROR: missing values:\n%s\n", join "\n\t", @missing
    if @missing;

  my $text_policy = JSON->new->pretty->encode( { Version => $POLICY_VERSION, Statement => \@statements } );

  foreach my $v ( keys %have_vars ) {
    my $value = $have_vars{$v};
    $text_policy =~ s/[@]$v[@]/$value/xsmg;
  }

  print {*STDOUT} $text_policy;

  return $SUCCESS;
}

########################################################################
sub cmd_list_permissions {
########################################################################
  my ($self) = @_;

  my $fragments = $self->_get_fragments;

  my %required;

  foreach my $f ( keys %{$fragments} ) {
    my $text = encode_json( $fragments->{$f} );
    my @vars;
    while ( $text =~ /[@]([^@]+)[@]/xsmg ) { push @vars, $1; }
    $required{$f} = [ uniq @vars ];
  }

  if ( $self->get_format =~ /^ya?ml$/xsm ) {
    my $permissions = <<'END_OF_TEXT';
---
# 1. Uncomment the permissions to include in your policy
#
# 2. Populate the required variables for the services you enable
#
# 3. Create a policy document
#
#    gha-aws create-permissions-policy permissions.yml > permissions-policy.json
#
# 4. Customize the policy if required
#
# 5. Create a role and apply the policy
#
#    gha-manage-role create permissions-policy.json
#
END_OF_TEXT

    $permissions .= "capabilities:\n#  - " . join "\n#  - ", sort keys %required;
    $permissions .= "\n\nvars:";
    foreach my $f ( sort keys %required ) {
      $permissions .= "\n# -- $f --\n";
      $permissions .= "#  " . join "\n#  ", map { $_ . ':' } @{ $required{$f} };
      $permissions .= "\n";
    }

    print {*STDOUT} $permissions;

    return $SUCCESS;
  }

  my $has_text_ascii_table = eval {
    require Text::ASCIITable;
    return 1;
  };

  if ( !$has_text_ascii_table ) {
    print {*STDOUT} JSON->new->pretty->encode( \%required );
    return $SUCCESS;
  }

  my $t = Text::ASCIITable->new( { headingText => 'Managed Permission Policies' } );
  $t->setCols( 'Policy', 'Required Variables', 'Actions' );

  foreach my $r ( sort keys %required ) {

    my $action      = $fragments->{$r}->[0]->{Action};
    my @action_list = sort map { ( split /[:]/xsm )[1] } ref $action ? @{$action} : $action;

    $t->addRow( $r, join( "\n", @{ $required{$r} } ), join "\n", @action_list );
    $t->addRowLine();
  }

  print {*STDOUT} $t;

  return $SUCCESS;
}

########################################################################
sub _get_fragments {
########################################################################
  my ($self) = @_;

  my @files = grep { !/(?:trust|permissions)/xsm } glob sprintf '%s/%s', dist_dir('GitHub-Actions-AWS'), '*.tpl';

  my %fragments;

  foreach my $f (@files) {
    my ($name) = $f =~ m{ ([^/]+) [.]json[.]tpl $ }xsm;
    $fragments{$name} = JSON->new->decode( slurp($f) );  # the full array
  }

  return \%fragments;
}

########################################################################
sub example {
########################################################################
  my $fragments = __PACKAGE__->_get_fragments;

  print JSON->new->pretty->encode($fragments);

  return $SUCCESS;
}

1;
